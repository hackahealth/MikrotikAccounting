# رمز پنل مدیریت
ADMIN_USER=admin
ADMIN_PASSWORD=ChangeMe!2026
# کلید رمزنگاری: اگر خالی بماند، یک کلید تصادفی در data/secret.key ساخته و نگه داشته می‌شود.
# اگر خودتان می‌گذارید (حداقل ۳۲ کاراکتر)، بعد از شروع کار تغییر ندهید چون رمزهای ذخیره‌شده با آن رمز شده‌اند.
# SECRET_KEY=
TZ_NAME=Asia/Tehran
WEB_PORT=8080
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
NETFLOW_PORT=2055
# فاصله Interim-Update (ثانیه) که به روتر اعلام می‌شود
ACCT_INTERIM=60
# پیش‌فرض SQLite در پوشه data است. برای PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://acct:acct@127.0.0.1/acct
